# Chatbot Service Configuration

# Provider options: mock, openai, groq
LLM_PROVIDER=openai

# OpenAI/GPT configuration.
# Create your own key in the OpenAI platform dashboard. Do not commit real keys.
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=
DEFAULT_MODEL=gpt-4o-mini

# Optional Groq configuration if LLM_PROVIDER=groq
GROQ_API_KEY=
LLM_FALLBACK_PROVIDERS=groq,mock
REDIS_URL=redis://localhost:6379/0
INFERENCE_LOG_STREAM=inference.logs

# Ingestion service URL
INGESTION_API_URL=http://localhost:8001/api/ingest

# Database path (SQLite)
DATABASE_PATH=./chatbot.db

# Security - Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=generate_random_key_here_generate_random_key_here
CSRF_COOKIE_SECURE=false

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# Server configuration
HOST=0.0.0.0
PORT=8000

# LLM configuration
CONTEXT_WINDOW_SIZE=10
MAX_TOKENS=1024

# Ingestion retry configuration
INGESTION_TIMEOUT_SECONDS=5
INGESTION_MAX_RETRIES=3
